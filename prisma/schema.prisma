// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// MODELS
// =============================================

model User {
  id           String   @id @default(uuid())
  nfc_uid      String?  @unique
  full_name    String
  email        String?  @unique
  phone_number String?  @unique
  password     String?
  balance      Decimal  @default(0) @db.Decimal(10, 2)

  // Relasi balik
  orders       Order[]
  usage_logs   UsageTransaction[]
  topup_logs   TopUpTransaction[]

  createdAt DateTime @default(now())
}

model Order {
  id              String   @id @default(uuid())
  order_id        String   @unique  // Midtrans order_id
  user_id         String?
  user            User?    @relation(fields: [user_id], references: [id])

  // Locker Info
  locker_size     String   // "Small" atau "Large"
  duration        Int      // Dalam jam

  // Payment Info
  gross_amount    Decimal  @db.Decimal(10, 2)
  payment_status  String   @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  transaction_id  String?  // Midtrans transaction_id

  // Customer Info
  customer_name   String?
  customer_email  String?
  customer_phone  String?

  // Timestamps
  payment_date    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

model Locker {
  id        Int     @id
  size_type String  // S, M, L
  price_h   Decimal @db.Decimal(10, 2)
  status    String  @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE

  // Relasi
  usages    UsageTransaction[]
}

model UsageTransaction {
  id       String @id @default(uuid())
  category String // "COURIER_DROP" atau "USER_DEPOSIT"

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  // Data Kurir / Non-User
  sender_phone    String?
  courier_name    String?
  resi_number     String?
  recipient_phone String
  pickup_code     String  @unique

  locker_id Int
  locker    Locker @relation(fields: [locker_id], references: [id])

  started_at    DateTime  @default(now())
  duration_plan Int?
  ended_at      DateTime?

  base_fee      Decimal @db.Decimal(10, 2)
  extension_fee Decimal @default(0) @db.Decimal(10, 2)
  status        String  @default("WAITING_FOR_PICKUP")
}

model TopUpTransaction {
  id             String   @id
  user_id        String
  user           User     @relation(fields: [user_id], references: [id])
  amount         Decimal  @db.Decimal(10, 2)
  payment_status String   @default("PENDING")
  createdAt      DateTime @default(now())
}
